              "});\r",
              "\r",
              "var jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"ID Users\", function () {\r",
              "    if (pm.response.code === 201) {\r",
              "        pm.globals.set(\"id\", jsonData.id);\r",
              "    }else {\r",
              "        pm.test.skip(\"id no generado\");\r",
              "    }\r",
              "});"
